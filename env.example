# Copia este archivo a .env.local y rellena los valores.
# En Vercel: Settings → Environment Variables.

# --- Claude API vía OrcAI (proxy) ---
ANTHROPIC_API_KEY=
# Endpoint del proxy OrcAI. Si lo dejas vacío, el SDK usa la API de Anthropic directa.
ANTHROPIC_BASE_URL=
# Modelo y tope de tokens por respuesta (Haiku para bajo costo/latencia).
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_TOKENS=600

# --- WhatsApp Business Cloud API — https://developers.facebook.com ---
# Token de acceso (usa un token permanente de System User en producción; el de prueba dura 24 h)
WHATSAPP_ACCESS_TOKEN=
# ID del número de teléfono (Phone Number ID, NO el número en sí)
WHATSAPP_PHONE_NUMBER_ID=
# Token de verificación del webhook (genéralo tú con `openssl rand -hex 32`;
# debe coincidir con el que pongas en Meta). El HMAC exige WHATSAPP_APP_SECRET:
# sin él, TODOS los POST de Meta se rechazan con 403 (fail-closed).
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (Settings → Basic) para validar la firma HMAC de los
# webhooks. OBLIGATORIO: sin este valor el webhook rechaza todos los POST (fail-closed).
WHATSAPP_APP_SECRET=

# --- Opcional: tu número personal para recibir avisos de handoff y topes (formato 573001234567) ---
OWNER_WHATSAPP_NUMBER=

# --- Upstash Redis (dedup, historial, handoff) — inyectadas por la integración de Vercel ---
# Si no las defines, el bot funciona sin persistencia (solo pruebas locales con `next dev`).
UPSTASH_REDIS_KV_REST_API_URL=
UPSTASH_REDIS_KV_REST_API_TOKEN=

# --- Límites (P0 de seguridad; ajustables sin redeploy) ---
# Máximo de mensajes por contacto y hora.
RL_MAX_PER_HOUR=20
# Tope global de llamadas a Claude por día (corte duro). Arranque conservador.
CLAUDE_DAILY_LIMIT=150
