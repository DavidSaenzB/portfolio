# Copia este archivo a .env.local y rellena los valores.
# En Vercel: Settings → Environment Variables.

# --- Anthropic (Claude API) — https://platform.claude.com ---
ANTHROPIC_API_KEY=sk-ant-...

# --- WhatsApp Business Cloud API — https://developers.facebook.com ---
# Token de acceso (usa un token permanente de System User en producción)
WHATSAPP_ACCESS_TOKEN=
# ID del número de teléfono (Phone Number ID, NO el número en sí)
WHATSAPP_PHONE_NUMBER_ID=
# Token de verificación del webhook (invéntalo tú; debe coincidir con el que pongas en Meta)
WHATSAPP_VERIFY_TOKEN=mi-token-secreto-123
# App Secret de la app de Meta (para validar la firma de los webhooks). Recomendado.
WHATSAPP_APP_SECRET=

# --- Opcional: tu número personal para recibir avisos de citas y leads (formato 573001234567) ---
OWNER_WHATSAPP_NUMBER=

# --- Upstash Redis (historial, citas y leads) — https://upstash.com o Vercel Marketplace ---
# Si no los defines, el bot usa memoria (solo sirve para pruebas locales con `next dev`)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
